generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Profiles ────────────────────────────────────────────────────────────────
model Profile {
  id        String   @id @default(uuid())
  fullName  String   @map("full_name")
  role      Role     @default(user_basic)
  isActive  Boolean  @default(true) @map("is_active")
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  loginHistory      UserLoginHistory[]
  modulePermissions UserModulePermission[]
  clientsCreated Client[] @relation("ClientCreatedBy")
  clientsUpdated Client[] @relation("ClientUpdatedBy")
  clientsDeleted Client[] @relation("ClientDeletedBy")

  measurementsCreated Measurement[] @relation("MeasurementCreatedBy")
  measurementsUpdated Measurement[] @relation("MeasurementUpdatedBy")
  measurementsDeleted Measurement[] @relation("MeasurementDeletedBy")

  articleTypesCreated ArticleType[] @relation("ArticleTypeCreatedBy")
  articleTypesUpdated ArticleType[] @relation("ArticleTypeUpdatedBy")

  articlesCreated Article[] @relation("ArticleCreatedBy")
  articlesUpdated Article[] @relation("ArticleUpdatedBy")
  articlesDeleted Article[] @relation("ArticleDeletedBy")

  ordersCreated Order[] @relation("OrderCreatedBy")
  ordersUpdated Order[] @relation("OrderUpdatedBy")
  ordersDeleted Order[] @relation("OrderDeletedBy")

  orderStatusChanges OrderStatusHistory[]

  expensesCreated Expense[] @relation("ExpenseCreatedBy")
  expensesUpdated Expense[] @relation("ExpenseUpdatedBy")
  expensesDeleted Expense[] @relation("ExpenseDeletedBy")

  paymentsCreated OrderPayment[] @relation("PaymentCreatedBy")
  paymentsUpdated OrderPayment[] @relation("PaymentUpdatedBy")
  paymentsDeleted OrderPayment[] @relation("PaymentDeletedBy")

  invoicesCreated Invoice[] @relation("InvoiceCreatedBy")
  invoicesUpdated Invoice[] @relation("InvoiceUpdatedBy")
  invoicesDeleted Invoice[] @relation("InvoiceDeletedBy")

  exchangeRatesCreated ExchangeRate[] @relation("ExchangeRateCreatedBy")
  exchangeRatesUpdated ExchangeRate[] @relation("ExchangeRateUpdatedBy")
  exchangeRatesDeleted ExchangeRate[] @relation("ExchangeRateDeletedBy")

  auditLogs AuditLog[]

  stockMovements           StockMovement[]
  stockEntriesCreated      StockEntry[]    @relation("EntryCreatedBy")
  stockEntriesValidated    StockEntry[]    @relation("EntryValidatedBy")
  stockExitsCreated        StockExit[]     @relation("ExitCreatedBy")
  stockExitsValidated      StockExit[]     @relation("ExitValidatedBy")
  stockTransfersCreated    StockTransfer[] @relation("TransferCreatedBy")
  stockTransfersValidated  StockTransfer[] @relation("TransferValidatedBy")
  stockAdjustments         StockAdjustment[]
  inventorySessionsCreated   InventorySession[] @relation("InventoryCreatedBy")
  inventorySessionsValidated InventorySession[] @relation("InventoryValidatedBy")

  @@map("profiles")
}

enum Role {
  admin
  manager
  accountant
  tailor
  user_basic

  @@map("role")
}

// ─── Module Permissions ───────────────────────────────────────────────────────
// Fine-grained per-user access control for roles accountant/tailor/user_basic.
// admin and manager always have full access and are never stored here.
model UserModulePermission {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  module    AppModule
  canView   Boolean   @default(false) @map("can_view")
  canCreate Boolean   @default(false) @map("can_create")
  canEdit   Boolean   @default(false) @map("can_edit")
  canDelete Boolean   @default(false) @map("can_delete")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
  @@map("user_module_permissions")
}

enum AppModule {
  clients
  mesures
  articles
  commandes
  depenses
  paiements
  factures
  rapports
  taux_de_change
  notifications
  utilisateurs
  parametres
  fournitures
  fournitures_entrees
  fournitures_sorties
  fournitures_transferts
  fournitures_inventaire
  fournitures_ajustements
  fournitures_etat_stock
  fournitures_historique
  fournitures_fournisseurs
  fournitures_emplacements

  @@map("app_module")
}

// ─── Login History ────────────────────────────────────────────────────────────
model UserLoginHistory {
  id                String      @id @default(uuid())
  userId            String      @map("user_id")
  loginAt           DateTime    @default(now()) @map("login_at")
  logoutAt          DateTime?   @map("logout_at")
  sessionDuration   Int?        @map("session_duration")
  ipAddress         String?     @map("ip_address")
  userAgent         String?     @map("user_agent")
  deviceType        String?     @map("device_type")
  browser           String?
  operatingSystem   String?     @map("operating_system")
  country           String?
  city              String?
  loginStatus       LoginStatus @default(success) @map("login_status")
  failureReason     String?     @map("failure_reason")
  sessionId         String?     @map("session_id")
  rememberTokenUsed Boolean     @default(false) @map("remember_token_used")
  createdAt         DateTime    @default(now()) @map("created_at")

  profile Profile @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_login_history")
}

enum LoginStatus {
  success
  failed
  blocked

  @@map("login_status")
}

// ─── Clients ──────────────────────────────────────────────────────────────────
model Client {
  id                  String    @id @default(uuid())
  fullName            String    @map("full_name")
  phone               String?
  email               String?
  whatsappNumber      String?   @map("whatsapp_number")
  notificationOptIn   Boolean   @default(true) @map("notification_opt_in")
  country             String?
  city                String?
  address             String?
  notes               String?
  createdById         String?   @map("created_by")
  updatedById         String?   @map("updated_by")
  deletedById         String?   @map("deleted_by")
  createdAt           DateTime  @default(now()) @map("created_at")
  updatedAt           DateTime  @updatedAt @map("updated_at")
  deletedAt           DateTime? @map("deleted_at")

  createdBy Profile? @relation("ClientCreatedBy", fields: [createdById], references: [id])
  updatedBy Profile? @relation("ClientUpdatedBy", fields: [updatedById], references: [id])
  deletedBy Profile? @relation("ClientDeletedBy", fields: [deletedById], references: [id])

  measurements  Measurement[]
  orders        Order[]
  invoices      Invoice[]
  notifications Notification[]

  @@map("clients")
}

// ─── Measurements ─────────────────────────────────────────────────────────────
model Measurement {
  id               String    @id @default(uuid())
  clientId         String    @map("client_id")
  profileName      String?   @map("profile_name")
  chest            Decimal?  @db.Decimal(6, 2)
  waist            Decimal?  @db.Decimal(6, 2)
  hips             Decimal?  @db.Decimal(6, 2)
  shoulders        Decimal?  @db.Decimal(6, 2)
  armLength        Decimal?  @map("arm_length") @db.Decimal(6, 2)
  neck             Decimal?  @db.Decimal(6, 2)
  shirtLength      Decimal?  @map("shirt_length") @db.Decimal(6, 2)
  trouserLength    Decimal?  @map("trouser_length") @db.Decimal(6, 2)
  dressLength      Decimal?  @map("dress_length") @db.Decimal(6, 2)
  wrist            Decimal?  @db.Decimal(6, 2)
  thigh            Decimal?  @db.Decimal(6, 2)
  knee             Decimal?  @db.Decimal(6, 2)
  ankle            Decimal?  @db.Decimal(6, 2)
  inseam           Decimal?  @db.Decimal(6, 2)
  customMeasurements Json?   @map("custom_measurements")
  notes            String?
  referencePhoto   String?   @map("reference_photo")
  createdById      String?   @map("created_by")
  updatedById      String?   @map("updated_by")
  deletedById      String?   @map("deleted_by")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdBy Profile? @relation("MeasurementCreatedBy", fields: [createdById], references: [id])
  updatedBy Profile? @relation("MeasurementUpdatedBy", fields: [updatedById], references: [id])
  deletedBy Profile? @relation("MeasurementDeletedBy", fields: [deletedById], references: [id])

  orders Order[]

  @@map("measurements")
}

// ─── Article Types ────────────────────────────────────────────────────────────
model ArticleType {
  id          String    @id @default(uuid())
  name        String
  description String?
  isActive    Boolean   @default(true) @map("is_active")
  createdById String?   @map("created_by")
  updatedById String?   @map("updated_by")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  createdBy Profile? @relation("ArticleTypeCreatedBy", fields: [createdById], references: [id])
  updatedBy Profile? @relation("ArticleTypeUpdatedBy", fields: [updatedById], references: [id])

  articles Article[]

  @@map("article_types")
}

// ─── Articles ─────────────────────────────────────────────────────────────────
model Article {
  id              String    @id @default(uuid())
  name            String
  description     String?
  articleTypeId   String?   @map("article_type_id")
  indicativePrice Decimal?  @map("indicative_price") @db.Decimal(12, 2)
  isActive        Boolean   @default(true) @map("is_active")
  createdById     String?   @map("created_by")
  updatedById     String?   @map("updated_by")
  deletedById     String?   @map("deleted_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  deletedAt       DateTime? @map("deleted_at")

  articleType ArticleType? @relation(fields: [articleTypeId], references: [id])
  createdBy   Profile?     @relation("ArticleCreatedBy", fields: [createdById], references: [id])
  updatedBy   Profile?     @relation("ArticleUpdatedBy", fields: [updatedById], references: [id])
  deletedBy   Profile?     @relation("ArticleDeletedBy", fields: [deletedById], references: [id])

  orderLines OrderLine[]

  @@map("articles")
}

// ─── Currencies ───────────────────────────────────────────────────────────────
model Currency {
  id       String  @id @default(uuid())
  code     String  @unique
  name     String
  symbol   String
  isActive Boolean @default(true) @map("is_active")

  exchangeRatesFrom ExchangeRate[] @relation("FromCurrency")
  exchangeRatesTo   ExchangeRate[] @relation("ToCurrency")

  orders        Order[]
  expenses      Expense[]
  orderPayments OrderPayment[]
  invoices      Invoice[]
  settings      Settings[]

  @@map("currencies")
}

// ─── Exchange Rates ───────────────────────────────────────────────────────────
model ExchangeRate {
  id             String    @id @default(uuid())
  fromCurrencyId String    @map("from_currency_id")
  toCurrencyId   String    @map("to_currency_id")
  rate           Decimal   @db.Decimal(18, 8)
  effectiveDate  DateTime  @map("effective_date")
  source         String?
  isActive       Boolean   @default(true) @map("is_active")
  notes          String?
  createdById    String?   @map("created_by")
  updatedById    String?   @map("updated_by")
  deletedById    String?   @map("deleted_by")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  fromCurrency Currency @relation("FromCurrency", fields: [fromCurrencyId], references: [id])
  toCurrency   Currency @relation("ToCurrency", fields: [toCurrencyId], references: [id])
  createdBy    Profile? @relation("ExchangeRateCreatedBy", fields: [createdById], references: [id])
  updatedBy    Profile? @relation("ExchangeRateUpdatedBy", fields: [updatedById], references: [id])
  deletedBy    Profile? @relation("ExchangeRateDeletedBy", fields: [deletedById], references: [id])

  @@map("exchange_rates")
}

// ─── Expense Categories ───────────────────────────────────────────────────────
model ExpenseCategory {
  id          String  @id @default(uuid())
  name        String
  description String?

  subcategories ExpenseSubcategory[]
  expenses      Expense[]

  @@map("expense_categories")
}

model ExpenseSubcategory {
  id          String  @id @default(uuid())
  categoryId  String  @map("category_id")
  name        String
  description String?

  category ExpenseCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  expenses Expense[]

  @@map("expense_subcategories")
}

// ─── Orders ───────────────────────────────────────────────────────────────────
model Order {
  id                   String      @id @default(uuid())
  orderNumber          String      @unique @map("order_number")
  clientId             String      @map("client_id")
  measurementId        String?     @map("measurement_id")
  country              String?
  city                 String?
  orderDetails         String?     @map("order_details")
  subtotal             Decimal     @default(0) @map("subtotal") @db.Decimal(12, 2)
  discount             Decimal     @default(0) @map("discount") @db.Decimal(12, 2)
  bonus                Decimal     @default(0) @map("bonus") @db.Decimal(12, 2)
  sellingPrice         Decimal     @map("selling_price") @db.Decimal(12, 2)
  currencyId           String      @map("currency_id")
  exchangeRateUsed     Decimal?    @map("exchange_rate_used") @db.Decimal(18, 8)
  amountUsd            Decimal?    @map("amount_usd") @db.Decimal(12, 2)
  amountXof            Decimal?    @map("amount_xof") @db.Decimal(12, 2)
  orderDate            DateTime    @default(now()) @map("order_date")
  expectedDeliveryDate DateTime?   @map("expected_delivery_date")
  actualDeliveryDate   DateTime?   @map("actual_delivery_date")
  currentStatus        OrderStatus @default(brouillon) @map("current_status")
  notes                String?
  createdById          String?     @map("created_by")
  updatedById          String?     @map("updated_by")
  deletedById          String?     @map("deleted_by")
  createdAt            DateTime    @default(now()) @map("created_at")
  updatedAt            DateTime    @updatedAt @map("updated_at")
  deletedAt            DateTime?   @map("deleted_at")

  client      Client       @relation(fields: [clientId], references: [id])
  measurement Measurement? @relation(fields: [measurementId], references: [id])
  currency    Currency     @relation(fields: [currencyId], references: [id])
  createdBy   Profile?     @relation("OrderCreatedBy", fields: [createdById], references: [id])
  updatedBy   Profile?     @relation("OrderUpdatedBy", fields: [updatedById], references: [id])
  deletedBy   Profile?     @relation("OrderDeletedBy", fields: [deletedById], references: [id])

  lines         OrderLine[]
  statusHistory OrderStatusHistory[]
  expenses      Expense[]
  payments      OrderPayment[]
  invoices      Invoice[]
  invoiceItems  InvoiceItem[]
  notifications Notification[]

  @@map("orders")
}

// ─── Order Lines ──────────────────────────────────────────────────────────────
model OrderLine {
  id          String  @id @default(uuid())
  orderId     String  @map("order_id")
  articleId   String? @map("article_id")
  description String?
  quantity    Int     @default(1)
  unitPrice   Decimal @map("unit_price") @db.Decimal(12, 2)
  lineTotal   Decimal @map("line_total") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  article Article? @relation(fields: [articleId], references: [id])

  @@map("order_lines")
}

enum OrderStatus {
  brouillon
  confirmee
  mesures_prises
  tissu_achete
  coupe
  couture
  essayage
  retouches
  finition
  pret_livraison
  livree
  annulee

  @@map("order_status")
}

// ─── Order Status History ─────────────────────────────────────────────────────
model OrderStatusHistory {
  id          String       @id @default(uuid())
  orderId     String       @map("order_id")
  oldStatus   OrderStatus? @map("old_status")
  newStatus   OrderStatus  @map("new_status")
  note        String?
  changedById String?      @map("changed_by")
  changedAt   DateTime     @default(now()) @map("changed_at")

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy Profile? @relation(fields: [changedById], references: [id])

  @@map("order_status_history")
}

// ─── Expenses ─────────────────────────────────────────────────────────────────
model Expense {
  id                String      @id @default(uuid())
  expenseNumber     String      @unique @map("expense_number")
  categoryId        String?     @map("category_id")
  subcategoryId     String?     @map("subcategory_id")
  orderId           String?     @map("order_id")
  linkedToOrder     Boolean     @default(false) @map("linked_to_order")
  expenseDate       DateTime    @map("expense_date")
  beneficiary       String?
  paymentType       PaymentType @map("payment_type")
  amountOriginal    Decimal     @map("amount_original") @db.Decimal(12, 2)
  currencyId        String      @map("currency_id")
  exchangeRateUsed  Decimal?    @map("exchange_rate_used") @db.Decimal(18, 8)
  amountUsd         Decimal?    @map("amount_usd") @db.Decimal(12, 2)
  amountXof         Decimal?    @map("amount_xof") @db.Decimal(12, 2)
  label             String?
  details           String?
  receiptAttachment String?     @map("receipt_attachment")
  createdById       String?     @map("created_by")
  updatedById       String?     @map("updated_by")
  deletedById       String?     @map("deleted_by")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")
  deletedAt         DateTime?   @map("deleted_at")

  category    ExpenseCategory?    @relation(fields: [categoryId], references: [id])
  subcategory ExpenseSubcategory? @relation(fields: [subcategoryId], references: [id])
  order       Order?              @relation(fields: [orderId], references: [id])
  currency    Currency            @relation(fields: [currencyId], references: [id])
  createdBy   Profile?            @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  updatedBy   Profile?            @relation("ExpenseUpdatedBy", fields: [updatedById], references: [id])
  deletedBy   Profile?            @relation("ExpenseDeletedBy", fields: [deletedById], references: [id])

  @@map("expenses")
}

enum PaymentType {
  cash
  mobile_money
  bank_transfer
  card
  wave
  orange_money

  @@map("payment_type")
}

// ─── Order Payments ───────────────────────────────────────────────────────────
model OrderPayment {
  id               String           @id @default(uuid())
  paymentNumber    String           @unique @map("payment_number")
  receiptNumber    String           @unique @map("receipt_number")
  orderId          String           @map("order_id")
  paymentType      OrderPaymentType @map("payment_type")
  amountOriginal   Decimal          @map("amount_original") @db.Decimal(12, 2)
  currencyId       String           @map("currency_id")
  exchangeRateUsed Decimal?         @map("exchange_rate_used") @db.Decimal(18, 8)
  amountUsd        Decimal?         @map("amount_usd") @db.Decimal(12, 2)
  amountXof        Decimal?         @map("amount_xof") @db.Decimal(12, 2)
  paymentDate      DateTime         @map("payment_date")
  paymentMethod    PaymentType      @map("payment_method")
  paymentReference String?          @map("payment_reference")
  label            String?
  details          String?
  createdById      String?          @map("created_by")
  updatedById      String?          @map("updated_by")
  deletedById      String?          @map("deleted_by")
  createdAt        DateTime         @default(now()) @map("created_at")
  updatedAt        DateTime         @updatedAt @map("updated_at")
  deletedAt        DateTime?        @map("deleted_at")

  order     Order    @relation(fields: [orderId], references: [id])
  currency  Currency @relation(fields: [currencyId], references: [id])
  createdBy Profile? @relation("PaymentCreatedBy", fields: [createdById], references: [id])
  updatedBy Profile? @relation("PaymentUpdatedBy", fields: [updatedById], references: [id])
  deletedBy Profile? @relation("PaymentDeletedBy", fields: [deletedById], references: [id])

  @@map("order_payments")
}

enum OrderPaymentType {
  acompte_initial
  acompte
  paiement_final
  remboursement
  bonus
  remise

  @@map("order_payment_type")
}

// ─── Invoices ─────────────────────────────────────────────────────────────────
model Invoice {
  id               String        @id @default(uuid())
  invoiceNumber    String        @unique @map("invoice_number")
  clientId         String        @map("client_id")
  orderId          String?       @map("order_id")
  issueDate        DateTime      @map("issue_date")
  dueDate          DateTime?     @map("due_date")
  subtotal         Decimal       @default(0) @map("subtotal") @db.Decimal(12, 2)
  discount         Decimal       @default(0) @map("discount") @db.Decimal(12, 2)
  bonus            Decimal       @default(0) @map("bonus") @db.Decimal(12, 2)
  totalAmount      Decimal       @map("total_amount") @db.Decimal(12, 2)
  currencyId       String        @map("currency_id")
  exchangeRateUsed Decimal?      @map("exchange_rate_used") @db.Decimal(18, 8)
  amountPaid       Decimal       @default(0) @map("amount_paid") @db.Decimal(12, 2)
  balanceDue       Decimal       @map("balance_due") @db.Decimal(12, 2)
  notes            String?
  pdfPath          String?       @map("pdf_path")
  status           InvoiceStatus @default(draft)
  createdById      String?       @map("created_by")
  updatedById      String?       @map("updated_by")
  deletedById      String?       @map("deleted_by")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")
  deletedAt        DateTime?     @map("deleted_at")

  client    Client       @relation(fields: [clientId], references: [id])
  order     Order?       @relation(fields: [orderId], references: [id])
  currency  Currency     @relation(fields: [currencyId], references: [id])
  items     InvoiceItem[]
  createdBy Profile?     @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  updatedBy Profile?     @relation("InvoiceUpdatedBy", fields: [updatedById], references: [id])
  deletedBy Profile?     @relation("InvoiceDeletedBy", fields: [deletedById], references: [id])

  @@map("invoices")
}

model InvoiceItem {
  id        String   @id @default(uuid())
  invoiceId String   @map("invoice_id")
  orderId   String   @map("order_id")
  amount    Decimal  @map("amount") @db.Decimal(12, 2)
  createdAt DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  order   Order   @relation(fields: [orderId], references: [id])

  @@map("invoice_items")
}

enum InvoiceStatus {
  draft
  issued
  partially_paid
  paid
  cancelled

  @@map("invoice_status")
}

// ─── Settings ─────────────────────────────────────────────────────────────────
model Settings {
  id                          String   @id @default(uuid())
  appName                     String   @default("DazzUrembo App") @map("app_name")
  companyName                 String   @map("company_name")
  logo                        String?
  favicon                     String?
  address                     String?
  city                        String?
  country                     String?
  phone                       String?
  whatsappNumber              String?  @map("whatsapp_number")
  email                       String?
  website                     String?
  slogan                      String?
  primaryColor                String   @default("#2563eb") @map("primary_color")
  secondaryColor              String   @default("#0f172a") @map("secondary_color")
  buttonColor                 String   @default("#2563eb") @map("button_color")
  sidebarColor                String   @default("#0f172a") @map("sidebar_color")
  taxNumber                   String?  @map("tax_number")
  defaultCurrencyId           String?  @map("default_currency_id")
  invoicePrefix               String   @default("FACT-") @map("invoice_prefix")
  receiptPrefix               String   @default("RECU-") @map("receipt_prefix")
  language                    String   @default("fr")
  whatsappEnabled             Boolean  @default(false) @map("whatsapp_enabled")
  whatsappApiKey              String?  @map("whatsapp_api_key")
  whatsappPhoneNumberId       String?  @map("whatsapp_phone_number_id")
  whatsappBusinessAccountId   String?  @map("whatsapp_business_account_id")
  companySenderName           String?  @map("company_sender_name")
  smsEnabled                  Boolean  @default(false) @map("sms_enabled")
  smsProvider                 String?  @map("sms_provider")
  smsApiKey                   String?  @map("sms_api_key")
  emailEnabled                Boolean  @default(false) @map("email_enabled")
  updatedAt                   DateTime @updatedAt @map("updated_at")

  defaultCurrency Currency? @relation(fields: [defaultCurrencyId], references: [id])

  @@map("settings")
}

// ─── Notifications ────────────────────────────────────────────────────────────
model Notification {
  id               String         @id @default(uuid())
  clientId         String         @map("client_id")
  orderId          String?        @map("order_id")
  channel          NotifChannel
  eventType        NotifEventType @map("event_type")
  recipient        String
  message          String
  status           NotifStatus    @default(pending)
  providerResponse String?        @map("provider_response")
  sentAt           DateTime?      @map("sent_at")
  createdAt        DateTime       @default(now()) @map("created_at")

  client Client  @relation(fields: [clientId], references: [id])
  order  Order?  @relation(fields: [orderId], references: [id])

  @@map("notifications")
}

enum NotifChannel {
  whatsapp
  sms
  email

  @@map("notif_channel")
}

enum NotifEventType {
  order_created
  order_ready
  order_delivered
  manual_send

  @@map("notif_event_type")
}

enum NotifStatus {
  pending
  sent
  failed

  @@map("notif_status")
}

// ─── Audit Logs ───────────────────────────────────────────────────────────────
model AuditLog {
  id           String      @id @default(uuid())
  userId       String?     @map("user_id")
  tableName    String      @map("table_name")
  recordId     String      @map("record_id")
  action       AuditAction
  oldValues    Json?       @map("old_values")
  newValues    Json?       @map("new_values")
  ipAddress    String?     @map("ip_address")
  userAgent    String?     @map("user_agent")
  actionDate   DateTime    @default(now()) @map("action_date")

  user Profile? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

enum AuditAction {
  create
  update
  delete

  @@map("audit_action")
}

// ─── Fournitures & Gestion de Stock ──────────────────────────────────────────

model SupplyCategory {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  supplies Supply[]

  @@map("supply_categories")
}

model Supplier {
  id             String   @id @default(uuid())
  name           String
  phone          String?
  whatsappNumber String?  @map("whatsapp_number")
  email          String?
  address        String?
  city           String?
  country        String?
  contactName    String?  @map("contact_name")
  notes          String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  supplies     Supply[]
  stockEntries StockEntry[]

  @@map("suppliers")
}

enum SupplyUnit {
  piece
  metre
  centimetre
  bobine
  rouleau
  kilogramme
  gramme
  litre
  paquet
  boite
  autre

  @@map("supply_unit")
}

model StockLocation {
  id          String   @id @default(uuid())
  name        String
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  stockBalances    StockBalance[]
  movementsFrom    StockMovement[]   @relation("MovementFromLocation")
  movementsTo      StockMovement[]   @relation("MovementToLocation")
  entryLines       StockEntryLine[]
  exitLines        StockExitLine[]
  transfersFrom    StockTransfer[]   @relation("TransferFrom")
  transfersTo      StockTransfer[]   @relation("TransferTo")
  adjustmentLines  StockAdjustmentLine[]
  inventorySessions InventorySession[]
  inventoryLines   InventoryLine[]
  defaultSupplies  Supply[]

  @@map("stock_locations")
}

model Supply {
  id                String         @id @default(uuid())
  code              String         @unique
  name              String
  categoryId        String?        @map("category_id")
  unit              SupplyUnit
  minimumStock      Decimal        @default(0) @map("minimum_stock") @db.Decimal(12, 3)
  description       String?
  defaultSupplierId String?        @map("default_supplier_id")
  referencePrice    Decimal?       @map("reference_price") @db.Decimal(12, 2)
  defaultLocationId String?        @map("default_location_id")
  isActive          Boolean        @default(true) @map("is_active")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  category        SupplyCategory? @relation(fields: [categoryId], references: [id])
  defaultSupplier Supplier?       @relation(fields: [defaultSupplierId], references: [id])
  defaultLocation StockLocation?  @relation(fields: [defaultLocationId], references: [id])

  stockBalances   StockBalance[]
  movements       StockMovement[]
  entryLines      StockEntryLine[]
  exitLines       StockExitLine[]
  transferLines   StockTransferLine[]
  adjustmentLines StockAdjustmentLine[]
  inventoryLines  InventoryLine[]

  @@map("supplies")
}

model StockBalance {
  id         String   @id @default(uuid())
  supplyId   String   @map("supply_id")
  locationId String   @map("location_id")
  quantity   Decimal  @default(0) @db.Decimal(12, 3)
  updatedAt  DateTime @updatedAt @map("updated_at")

  supply   Supply        @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  location StockLocation @relation(fields: [locationId], references: [id], onDelete: Cascade)

  @@unique([supplyId, locationId])
  @@map("stock_balances")
}

enum StockMovementType {
  entry
  exit
  transfer_out
  transfer_in
  adjustment
  inventory_adjustment

  @@map("stock_movement_type")
}

model StockMovement {
  id             String            @id @default(uuid())
  reference      String
  type           StockMovementType
  supplyId       String            @map("supply_id")
  quantity       Decimal           @db.Decimal(12, 3)
  unit           SupplyUnit
  fromLocationId String?           @map("from_location_id")
  toLocationId   String?           @map("to_location_id")
  unitCost       Decimal?          @map("unit_cost") @db.Decimal(12, 2)
  totalCost      Decimal?          @map("total_cost") @db.Decimal(12, 2)
  reason         String?
  comment        String?
  createdById    String?           @map("created_by")
  createdAt      DateTime          @default(now()) @map("created_at")

  supply       Supply         @relation(fields: [supplyId], references: [id])
  fromLocation StockLocation? @relation("MovementFromLocation", fields: [fromLocationId], references: [id])
  toLocation   StockLocation? @relation("MovementToLocation", fields: [toLocationId], references: [id])
  createdBy    Profile?       @relation(fields: [createdById], references: [id])

  @@map("stock_movements")
}

enum EntryStatus {
  draft
  validated
  cancelled

  @@map("entry_status")
}

model StockEntry {
  id              String      @id @default(uuid())
  reference       String      @unique
  date            DateTime
  supplierId      String?     @map("supplier_id")
  supplierInvoice String?     @map("supplier_invoice")
  locationId      String?     @map("location_id")
  comment         String?
  status          EntryStatus @default(draft)
  totalAmount     Decimal     @default(0) @map("total_amount") @db.Decimal(12, 2)
  createdById     String?     @map("created_by")
  validatedById   String?     @map("validated_by")
  validatedAt     DateTime?   @map("validated_at")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  supplier    Supplier?       @relation(fields: [supplierId], references: [id])
  createdBy   Profile?        @relation("EntryCreatedBy", fields: [createdById], references: [id])
  validatedBy Profile?        @relation("EntryValidatedBy", fields: [validatedById], references: [id])
  lines       StockEntryLine[]

  @@map("stock_entries")
}

model StockEntryLine {
  id        String  @id @default(uuid())
  entryId   String  @map("entry_id")
  supplyId  String  @map("supply_id")
  locationId String @map("location_id")
  quantity  Decimal @db.Decimal(12, 3)
  unitCost  Decimal @map("unit_cost") @db.Decimal(12, 2)
  totalCost Decimal @map("total_cost") @db.Decimal(12, 2)

  entry    StockEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  supply   Supply        @relation(fields: [supplyId], references: [id])
  location StockLocation @relation(fields: [locationId], references: [id])

  @@map("stock_entry_lines")
}

enum ExitDestination {
  atelier_couture
  boutique
  depot
  autre
  perte_dommage

  @@map("exit_destination")
}

enum ExitReason {
  consommation_production
  reparation
  echantillon
  perte
  dommage
  don
  ajustement
  autre

  @@map("exit_reason")
}

enum ExitStatus {
  draft
  validated
  cancelled

  @@map("exit_status")
}

model StockExit {
  id            String          @id @default(uuid())
  reference     String          @unique
  date          DateTime
  destination   ExitDestination
  reason        ExitReason
  externalRef   String?         @map("external_ref")
  comment       String?
  status        ExitStatus      @default(draft)
  createdById   String?         @map("created_by")
  validatedById String?         @map("validated_by")
  validatedAt   DateTime?       @map("validated_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  createdBy   Profile?       @relation("ExitCreatedBy", fields: [createdById], references: [id])
  validatedBy Profile?       @relation("ExitValidatedBy", fields: [validatedById], references: [id])
  lines       StockExitLine[]

  @@map("stock_exits")
}

model StockExitLine {
  id         String  @id @default(uuid())
  exitId     String  @map("exit_id")
  supplyId   String  @map("supply_id")
  locationId String  @map("location_id")
  quantity   Decimal @db.Decimal(12, 3)

  exit     StockExit     @relation(fields: [exitId], references: [id], onDelete: Cascade)
  supply   Supply        @relation(fields: [supplyId], references: [id])
  location StockLocation @relation(fields: [locationId], references: [id])

  @@map("stock_exit_lines")
}

enum TransferStatus {
  draft
  shipped
  received
  cancelled

  @@map("transfer_status")
}

model StockTransfer {
  id             String         @id @default(uuid())
  reference      String         @unique
  date           DateTime
  fromLocationId String         @map("from_location_id")
  toLocationId   String         @map("to_location_id")
  comment        String?
  status         TransferStatus @default(draft)
  createdById    String?        @map("created_by")
  validatedById  String?        @map("validated_by")
  validatedAt    DateTime?      @map("validated_at")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  fromLocation StockLocation       @relation("TransferFrom", fields: [fromLocationId], references: [id])
  toLocation   StockLocation       @relation("TransferTo", fields: [toLocationId], references: [id])
  createdBy    Profile?            @relation("TransferCreatedBy", fields: [createdById], references: [id])
  validatedBy  Profile?            @relation("TransferValidatedBy", fields: [validatedById], references: [id])
  lines        StockTransferLine[]

  @@map("stock_transfers")
}

model StockTransferLine {
  id         String  @id @default(uuid())
  transferId String  @map("transfer_id")
  supplyId   String  @map("supply_id")
  quantity   Decimal @db.Decimal(12, 3)

  transfer StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  supply   Supply        @relation(fields: [supplyId], references: [id])

  @@map("stock_transfer_lines")
}

enum AdjustmentReason {
  erreur_saisie
  perte
  casse
  vol
  inventaire
  correction_administrative
  autre

  @@map("adjustment_reason")
}

model StockAdjustment {
  id          String           @id @default(uuid())
  reference   String           @unique
  date        DateTime
  reason      AdjustmentReason
  comment     String?
  createdById String?          @map("created_by")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  createdBy Profile?              @relation(fields: [createdById], references: [id])
  lines     StockAdjustmentLine[]

  @@map("stock_adjustments")
}

model StockAdjustmentLine {
  id             String  @id @default(uuid())
  adjustmentId   String  @map("adjustment_id")
  supplyId       String  @map("supply_id")
  locationId     String  @map("location_id")
  quantityBefore Decimal @map("quantity_before") @db.Decimal(12, 3)
  quantityAfter  Decimal @map("quantity_after") @db.Decimal(12, 3)
  quantityDelta  Decimal @map("quantity_delta") @db.Decimal(12, 3)

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id], onDelete: Cascade)
  supply     Supply          @relation(fields: [supplyId], references: [id])
  location   StockLocation   @relation(fields: [locationId], references: [id])

  @@map("stock_adjustment_lines")
}

enum InventoryStatus {
  draft
  in_progress
  validated
  cancelled

  @@map("inventory_status")
}

model InventorySession {
  id            String          @id @default(uuid())
  reference     String          @unique
  date          DateTime
  locationId    String?         @map("location_id")
  comment       String?
  status        InventoryStatus @default(draft)
  createdById   String?         @map("created_by")
  validatedById String?         @map("validated_by")
  validatedAt   DateTime?       @map("validated_at")
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  location    StockLocation? @relation(fields: [locationId], references: [id])
  createdBy   Profile?       @relation("InventoryCreatedBy", fields: [createdById], references: [id])
  validatedBy Profile?       @relation("InventoryValidatedBy", fields: [validatedById], references: [id])
  lines       InventoryLine[]

  @@map("inventory_sessions")
}

model InventoryLine {
  id            String   @id @default(uuid())
  sessionId     String   @map("session_id")
  supplyId      String   @map("supply_id")
  locationId    String   @map("location_id")
  theoreticalQty Decimal @map("theoretical_qty") @db.Decimal(12, 3)
  physicalQty   Decimal? @map("physical_qty") @db.Decimal(12, 3)
  variance      Decimal? @db.Decimal(12, 3)

  session  InventorySession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  supply   Supply           @relation(fields: [supplyId], references: [id])
  location StockLocation    @relation(fields: [locationId], references: [id])

  @@map("inventory_lines")
}

